From 0387097d3b31c98ff9dc15a77790b21c410376a1 Mon Sep 17 00:00:00 2001
From: Graham Seamans <seamansgraham@gmail.com>
Date: Sat, 3 Oct 2026 08:17:29 -0700
Subject: [PATCH] Pin the BEAT Engine 0.3.0 release

0.3.0 adds the interface_radiated_pressure output that this commit's
coupled projects request (feat/interface-radiation, #28); 0.2.0 rejects it.
Wheel URL and sha256 from the v0.3.0 release SHA256SUMS.txt.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01MXLCRc7E1cDCAXXCEn1VoL
---
 pyproject.toml                          | 2 +-
 src/blab/solvers/engine_distribution.py | 4 ++--
 tests/test_engine_distribution.py       | 2 +-
 3 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index e5a65d2..5f94207 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -9,7 +9,7 @@ description = "Boundary element loudspeaker radiation solver"
 readme = "README.md"
 requires-python = ">=3.11"
 dependencies = [
-  "beat-engine @ https://github.com/JWSound/BEAT_Engine/releases/download/v0.2.0/beat_engine-0.2.0-py3-none-any.whl#sha256=bccad47b9647e5f4f7bc1ca6ac9d22e2e7751f1f39046fadc1e5e9782a282ad1",
+  "beat-engine @ https://github.com/JWSound/BEAT_Engine/releases/download/v0.3.0/beat_engine-0.3.0-py3-none-any.whl#sha256=b1476287d893a208d14f6c5ef2292e7a831c78d903d72357a5a29a291016fdae",
   "gmsh",
   "matplotlib",
   "meshio",
diff --git a/src/blab/solvers/engine_distribution.py b/src/blab/solvers/engine_distribution.py
index 40299fc..e4d726d 100644
--- a/src/blab/solvers/engine_distribution.py
+++ b/src/blab/solvers/engine_distribution.py
@@ -5,8 +5,8 @@ try:
 except ImportError as exc:
     raise RuntimeError("BEAT Engine is not installed. Reinstall Boundary Lab with its declared dependencies.") from exc
 
-if beat_engine.__version__ != "0.2.0":
-    raise RuntimeError(f"Boundary Lab requires beat-engine 0.2.0; found {beat_engine.__version__}.")
+if beat_engine.__version__ != "0.3.0":
+    raise RuntimeError(f"Boundary Lab requires beat-engine 0.3.0; found {beat_engine.__version__}.")
 
 from beat_engine import backend_catalog as backend_catalog
 from beat_engine import backend_info as engine_backend_info
diff --git a/tests/test_engine_distribution.py b/tests/test_engine_distribution.py
index 8a43dfb..0de7cc9 100644
--- a/tests/test_engine_distribution.py
+++ b/tests/test_engine_distribution.py
@@ -52,4 +52,4 @@ sys.modules['beat_engine'] = engine
 import blab.solvers.engine_distribution
 """)
     assert process.returncode != 0
-    assert "requires beat-engine 0.2.0; found 0.0.0" in process.stderr
+    assert "requires beat-engine 0.3.0; found 0.0.0" in process.stderr
-- 
2.43.0

